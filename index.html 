<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Will You Be My Valentine? ❤️</title>

<style>
*{
margin:0;
padding:0;
box-sizing:border-box;
}

body{
font-family:Georgia,serif;

/* Background image + pink overlay */
background:
linear-gradient(rgba(255,182,193,.35),rgba(255,182,193,.35)),
url("background.png") center/cover no-repeat fixed;

min-height:100vh;
display:flex;
justify-content:center;
align-items:center;
}

/* 💗 Container */
.container{
width:min(95vw,900px);
background:#fff0f6;
border-radius:25px;
padding:clamp(20px,3vw,40px);

box-shadow:0 25px 70px rgba(255,105,180,.35);
text-align:center;

animation:fadeIn 1s ease;
}

@keyframes fadeIn{
from{opacity:0;transform:scale(.95);}
to{opacity:1;transform:scale(1);}
}

/* Title */
h1{
color:#ff3b88;
font-size:clamp(1.8rem,3vw,2.5rem);
margin-bottom:15px;
animation:pulse 2s infinite;
}



/* ❤️ Heart layout */
.heart-layout{
display:grid;
grid-template-columns:1fr 1fr 1fr;
grid-template-rows:auto auto;
gap:clamp(20px,4vw,40px);
justify-items:center;
align-items:center;
margin:30px 0;
}

/* Photos */
.photo-frame{
width:clamp(120px,18vw,200px);
height:clamp(150px,22vw,250px);

border-radius:20px;
overflow:hidden;
border:5px solid white;

box-shadow:0 12px 30px rgba(255,105,180,.4);
cursor:pointer;
transition:.4s;
}

.photo-frame:hover{
transform:scale(1.1) rotate(2deg);
box-shadow:0 25px 50px rgba(255,20,147,.5);
}

.photo-frame img{
width:100%;
height:100%;
object-fit:cover;
}

.left{grid-column:1;grid-row:2;}
.top{grid-column:2;grid-row:1;}
.right{grid-column:3;grid-row:2;}

/* 💌 Envelope */
.central-envelope{
grid-column:2;
grid-row:2;

width:clamp(110px,15vw,160px);
height:clamp(150px,18vw,200px);

cursor:pointer;
position:relative;
perspective:800px;
transition:.3s;
}

.central-envelope:hover{
transform:scale(1.08);
}

.envelope-back{
width:100%;
height:100%;
background:linear-gradient(145deg,#ffd6e8,#ffc0d6);
border-radius:15px 15px 40px 40px;
border:3px solid #ff8ab6;
box-shadow:0 12px 30px rgba(255,105,180,.4);
}

.envelope-flap{
position:absolute;
top:-2px;
left:0;
width:100%;
height:50%;
background:#ffc0d6;

clip-path:polygon(0 0,100% 0,50% 100%);
transform-origin:top center;
transition:.6s;
}

.central-envelope.open .envelope-flap{
transform:rotateX(180deg);
}

.envelope-heart{
position:absolute;
top:15px;
left:50%;
transform:translateX(-50%);
font-size:22px;
color:#ff2f7a;
transition:.3s;
}

.central-envelope.open .envelope-heart{
opacity:0;
}

.envelope-note{
position:absolute;
top:50%;
left:50%;
transform:translate(-50%,-50%) scale(.8);

background:#fff;
padding:18px;
border-radius:12px;
border:2px dashed #ff6fa3;

box-shadow:0 5px 20px rgba(255,105,180,.3);
opacity:0;
transition:.5s;
text-align:center;
}

.central-envelope.open .envelope-note{
opacity:1;
transform:translate(-50%,-50%) scale(1);
}

/* Buttons */
.buttons{
display:flex;
justify-content:center;
gap:20px;
margin-top:20px;
}

.btn{
padding:14px 35px;
font-size:1.1em;
border:none;
border-radius:50px;
cursor:pointer;
font-weight:bold;
transition:.3s;
}

.btn-yes{
background:#ff3b88;
color:white;
}

.btn-yes:hover{
background:#e91e63;
transform:scale(1.1);
}

.btn-no{
background:#b0a4ad;
color:white;
}

.btn-no:hover{
background:#8d7b86;
}

/* Modal */
.modal{
display:none;
position:fixed;
inset:0;
background:rgba(0,0,0,.85);
}

.modal-content{
position:absolute;
top:50%;
left:50%;
transform:translate(-50%,-50%);
max-width:90%;
max-height:85%;
border-radius:12px;
}

.close{
position:absolute;
top:20px;
right:30px;
color:white;
font-size:40px;
cursor:pointer;
}

/* Mobile */
@media(max-width:700px){
.heart-layout{
display:flex;
flex-direction:column;
}
}
</style>
</head>

<body>

<div class="container">

<h1>Baby, will you be my Valentine??</h1>


<div class="heart-layout">

<div class="photo-frame left" onclick="openModal('photo1.jpg')">
<img src="photo1.jpg">
</div>

<div class="photo-frame top" onclick="openModal('photo2.jpg')">
<img src="photo2.jpg">
</div>

<div class="photo-frame right" onclick="openModal('photo3.jpg')">
<img src="photo3.jpg">
</div>

<div class="central-envelope" onclick="toggleEnvelope(this)">
<div class="envelope-heart">💌</div>
<div class="envelope-back"></div>
<div class="envelope-flap"></div>

<div class="envelope-note">
<h3>Dear baby:</h3>
<p>
Thank you for always being here by my side.<br>
For the second year, I'll ask again, will you be my valentine?
</p>
</div>
</div>

</div>


<div class="buttons">
<button class="btn btn-yes" onclick="sayYes()">Yes! 💖</button>
<button class="btn btn-no" id="noBtn" onclick="moveButton()">No</button>
</div>

</div>

<!-- Modal -->
<div id="imageModal" class="modal">
<span class="close" onclick="closeModal()">&times;</span>
<img id="modalImage" class="modal-content">
</div>

<script>
function toggleEnvelope(e){
e.classList.toggle("open");
}

function openModal(src){
document.getElementById("imageModal").style.display="block";
document.getElementById("modalImage").src=src;
}

function closeModal(){
document.getElementById("imageModal").style.display="none";
}

function sayYes(){
alert("Thank you for letting me be your valentine again this year! <3 ");
}

function moveButton(){
const btn=document.getElementById("noBtn");
btn.style.position="fixed";
btn.style.left=Math.random()*(window.innerWidth-100)+"px";
btn.style.top=Math.random()*(window.innerHeight-50)+"px";
}

window.onclick=function(e){
if(e.target==document.getElementById("imageModal"))
closeModal();
}
</script>

</body>
</html>
